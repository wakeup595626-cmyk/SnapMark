{
  "name": "snapmark",
  "version": "1.0.0",
  "description": "浏览器内批量给截图添加姓名、学号、班级等标注，导出命名规范的 ZIP；图片和名单不上传。",
  "private": true,
  "scripts": {
    "start": "npx serve .",
    "test:fixtures": "node test/gen_test_imgs.js",
    "test:e2e": "node test/e2e.js",
    "test:batch": "node test/e2e_batch.js",
    "test:v2": "node test/e2e_v2.js",
    "test:wizard": "node test/check_wizard.js",
    "test:features": "node test/check_new_features.js",
    "test:file-mobile": "node test/check_file_and_mobile.js",
    "test:desktop": "node test/check_desktop.js"
  },
  "keywords": ["screenshot", "watermark", "annotate", "batch", "privacy"],
  "license": "MIT",
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
